{
  "name": "Kcalm",
  "version": 1,
  "color": {
    "light": {
      "bg": "#F3F4F6",
      "card": "#FFFFFF",
      "sheet": "#F3F4F6",
      "nav": "#FFFFFF",
      "segmentTrack": "#E6E8EC",
      "segmentTrackInCard": "#F0F1F4",
      "text": "#0D0E12",
      "muted": "#646874",
      "line": "#ECEDF0",
      "track": "#E9EBF0",
      "accent": "#3D5AFE",
      "onAccent": "#FFFFFF",
      "accentText": "#2F4BE8",
      "accentSoft": "#EEF1FF",
      "accentSoftBorder": "#C7D0FF",
      "over": "#E8613C",
      "danger": "#D93A30",
      "warnText": "#B4471E",
      "neutralBar": "#C9CCD3",
      "chevronMuted": "#C5C9D2",
      "scrim": "rgba(0,0,0,0.38)"
    },
    "dark": {
      "bg": "#0A0A0C",
      "card": "#16171B",
      "sheet": "#101114",
      "nav": "#1E1F24",
      "segmentTrack": "#1E1F24",
      "segmentTrackInCard": "#202127",
      "text": "#F4F5F7",
      "muted": "#9A9EA8",
      "line": "#26282E",
      "track": "#2A2C33",
      "accent": "#3D5AFE",
      "onAccent": "#FFFFFF",
      "accentText": "#8C9BFF",
      "accentSoft": "#1C2148",
      "accentSoftBorder": "#2E3880",
      "over": "#E8613C",
      "danger": "#E5534B",
      "warnText": "#F08A63",
      "neutralBar": "#4A4D57",
      "chevronMuted": "#4A4D57",
      "scrim": "rgba(0,0,0,0.55)"
    }
  },
  "font": {
    "family": "Geist",
    "fallback": "system-ui, -apple-system, sans-serif",
    "weights": [400, 500, 600],
    "features": "tnum",
    "mono": "Geist Mono"
  },
  "type": {
    "hero": { "size": 44, "weight": 600, "letterSpacing": -1.5, "use": "Große Zahl in Sheets, Schätzung, Schnelleintrag" },
    "ring": { "size": 34, "weight": 600, "letterSpacing": -1, "use": "Zahl im Ring, Wochenbudget" },
    "title": { "size": 26, "weight": 600, "letterSpacing": -0.5, "use": "Screen-Titel" },
    "sheetTitle": { "size": 17, "weight": 600, "use": "Titel in Sheets und Unterseiten" },
    "body": { "size": 15, "weight": 400, "use": "Listen, Slot-Namen (600)" },
    "bodyLarge": { "size": 16, "weight": 400, "use": "Eingabefelder, Datum" },
    "secondary": { "size": 13, "weight": 400, "use": "Metadaten, Makro-Labels" },
    "small": { "size": 12, "weight": 400, "use": "Hinweise, Legenden" },
    "tiny": { "size": 11, "weight": 400, "use": "Achsen, Kacheln" },
    "keypad": { "size": 22, "weight": 500, "use": "Ziffernblock" }
  },
  "radius": {
    "summaryCard": 24,
    "card": 18,
    "field": 14,
    "key": 14,
    "segment": 12,
    "segmentItem": 9,
    "chip": 17,
    "nav": 31,
    "sheetTop": 28,
    "barTop": 4
  },
  "space": {
    "screenX": 16,
    "cardGap": 10,
    "cardPadding": 16,
    "navInsetX": 20,
    "navInsetBottom": 26,
    "navHeight": 62,
    "scrollBottomPadding": 120,
    "touchMin": 44,
    "rowMin": 48
  },
  "ring": { "size": 142, "stroke": 12 },
  "motion": {
    "sheetIn": { "durationMs": 420, "easing": "cubic-bezier(.2,1.15,.35,1)" },
    "sheetOut": { "durationMs": 220, "easing": "cubic-bezier(.4,0,1,1)" },
    "scrimIn": { "durationMs": 260, "easing": "ease" },
    "press": { "durationMs": 140, "scale": 0.95, "easing": "cubic-bezier(.2,.8,.2,1)" },
    "chevron": { "durationMs": 240, "easing": "cubic-bezier(.2,.8,.2,1)" },
    "expand": { "durationMs": 300, "offsetY": -8, "easing": "cubic-bezier(.2,.9,.3,1)" },
    "numberTween": { "durationMs": 650, "easing": "easeOutCubic" },
    "barsAndRing": { "durationMs": 520, "easing": "cubic-bezier(.2,.8,.2,1)" },
    "sheetStep": { "durationMs": 280, "offsetX": 18, "easing": "cubic-bezier(.2,.9,.3,1)" },
    "toast": { "durationMs": 360, "visibleMs": 2200, "easing": "cubic-bezier(.2,1.3,.4,1)" },
    "switchKnob": { "durationMs": 220, "easing": "cubic-bezier(.2,1.2,.4,1)" },
    "rowSwipeSnap": { "durationMs": 260, "easing": "cubic-bezier(.2,.9,.25,1.15)", "revealPx": 88, "thresholdPx": 44 },
    "newEntryFlash": { "durationMs": 1400, "color": "accent at 18 %" },
    "reducedMotion": "Alle Animationen aus, Zustände und Zahlen sofort"
  }
}
